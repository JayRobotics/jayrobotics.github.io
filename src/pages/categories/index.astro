---
import PageLayout from '../../layouts/PageLayout.astro';
import { getPosts, groupByCategory } from '../../lib/posts';

const categories = groupByCategory(await getPosts());
---

<PageLayout title="카테고리 - Real Robot">
  <h1 class="mb-6 text-2xl font-bold tracking-tight text-[var(--heading)]">카테고리</h1>

  <ul class="grid gap-3 sm:grid-cols-2">
    {
      categories.map((c) => (
        <li>
          <a
            href={`/categories/${c.slug}/`}
            class="flex items-baseline justify-between gap-3 rounded-lg border border-[var(--border)] px-4 py-3 transition-colors hover:border-[var(--accent)]"
          >
            <span class="font-medium text-[var(--text)]">{c.name}</span>
            <span class="num text-sm text-[var(--text-muted)]">{String(c.posts.length).padStart(2, "0")}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
