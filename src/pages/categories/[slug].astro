---
import PageLayout from '../../layouts/PageLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByCategory } from '../../lib/posts';

export async function getStaticPaths() {
  const groups = groupByCategory(await getPosts());
  return groups.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}

const { group } = Astro.props;
---

<PageLayout title={`${group.name} - Real Robot`}>
  <header class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-[var(--heading)]">{group.name}</h1>
    <p class="num mt-2 text-[0.82rem] text-[var(--text-muted)]">{group.posts.length} posts</p>
  </header>

  <PostList posts={group.posts} />
</PageLayout>
