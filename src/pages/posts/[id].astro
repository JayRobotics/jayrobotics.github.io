---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Toc from '../../components/Toc.astro';
import { formatDate, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const posted = formatDate(post.data.date);
---

<BaseLayout title={post.data.title} image={post.data.image?.path}>
  <SiteHeader />

  <!--
    Three columns so the article stays optically centred while the table of
    contents sits in the right gutter. The empty left column is what keeps the
    text from drifting left on wide screens.
  -->
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-x-8 px-4 py-12 toc:grid-cols-[1fr_minmax(0,42rem)_1fr]"
  >
    <div class="hidden toc:block" aria-hidden="true"></div>

    <main class="min-w-0">
      <header class="mb-10">
        <h1
          class="text-3xl leading-snug font-bold tracking-tight text-[var(--heading)]"
          style="word-break: keep-all"
        >
          {post.data.title}
        </h1>

        <div
          class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--text-muted)]"
        >
          <time datetime={post.data.date.toISOString()}>{posted}</time>
          {
            post.data.categories.map((c) => (
              <a href={`/categories/${slugify(c)}/`} class="hover:text-[var(--accent)]">
                {c}
              </a>
            ))
          }
        </div>
      </header>

      <!-- Narrower than the `toc` breakpoint there is no gutter, so it collapses. -->
      {
        post.data.toc && (
          <details
            class="mb-10 rounded border border-[var(--border)] bg-[var(--surface)] px-4 py-3 toc:hidden"
          >
            <summary class="cursor-pointer text-sm font-medium text-[var(--text-muted)]">
              목차
            </summary>
            <Toc headings={headings} class="mt-3" />
          </details>
        )
      }

      <article class="prose">
        <Content />
      </article>

      {
        post.data.tags.length > 0 && (
          <footer class="mt-12 flex flex-wrap gap-2 border-t border-[var(--border)] pt-6">
            {post.data.tags.map((t) => (
              <a
                href={`/tags/${slugify(t)}/`}
                class="rounded-full border border-[var(--border)] px-3 py-1 text-sm text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
              >
                {t}
              </a>
            ))}
          </footer>
        )
      }
    </main>

    {
      post.data.toc && (
        <aside class="hidden toc:block">
          <div class="sticky top-8 max-h-[calc(100dvh-6rem)] overflow-y-auto pb-6">
            <p class="mb-3 text-sm font-semibold text-[var(--heading)]">목차</p>
            <Toc headings={headings} tracking />
          </div>
        </aside>
      )
    }
  </div>

  <footer class="mx-auto w-full max-w-7xl px-4 pb-10 text-sm text-[var(--text-muted)]">
    <p>&copy; {new Date().getFullYear()} JaeJin Hwang</p>
  </footer>
</BaseLayout>
