---
import PageLayout from '../../layouts/PageLayout.astro';
import { getPosts, groupByTag } from '../../lib/posts';

const tags = groupByTag(await getPosts());
---

<PageLayout title="태그 - Real Robot">
  <h1 class="mb-6 text-2xl font-bold tracking-tight text-[var(--heading)]">태그</h1>

  <ul class="flex flex-wrap gap-2">
    {
      tags.map((t) => (
        <li>
          <a
            href={`/tags/${t.slug}/`}
            class="inline-flex items-baseline gap-1.5 rounded-full border border-[var(--border)] px-3 py-1 text-sm text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            {t.name}
            <span class="num text-[0.72rem] opacity-80">{t.posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
