---
import PostList from './PostList.astro';
import SeriesShelf from './SeriesShelf.astro';
import { groupByCategory, type Post } from '../lib/posts';

interface Props {
  /** The posts on this page of the list. */
  posts: Post[];
  /** Every post, for the category counts and the shelf. */
  all: Post[];
  page: number;
  totalPages: number;
}

const { posts, all, page, totalPages } = Astro.props;

const categories = groupByCategory(all);

// The series on the shelf is whichever category was posted in most recently.
// Nothing marks a series by hand, so nothing has to be maintained.
const byDate = [...all].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const shelfName = byDate[0]?.data.categories[0];
const shelf = categories.find((c) => c.name === shelfName);
const latest = byDate[0];

const pageHref = (n: number) => (n === 1 ? '/' : `/page${n}/`);
---

{
  page === 1 && (
    <>
      <section class="mb-14">
        <h1
          class="text-3xl leading-[1.3] font-bold tracking-tight text-[var(--heading)] sm:text-4xl"
          style="word-break: keep-all"
        >
          Physical AI를 공부하며 남기는 기록
        </h1>

        <p class="mt-4 max-w-[34rem] text-[var(--text-muted)]" style="word-break: keep-all">
          강화학습으로 정책을 학습시키는 일과, 그 정책이 실제 하드웨어 위에서 무너지지 않게
          만드는 일 사이의 간극에 관심이 있습니다.
        </p>

        {/* Counts read against a rule rather than inside pills. The figure is
            the information; a border around each one adds nothing. */}
        <dl class="mt-9 grid grid-cols-2 border-t border-[var(--border-strong)] sm:grid-cols-4">
          {categories.map((c) => (
            <div class="border-b border-[var(--border)]">
              <a href={`/categories/${c.slug}/`} class="group block py-3 pe-3">
                <dt class="text-[0.82rem] text-[var(--text-muted)] transition-colors group-hover:text-[var(--accent)]">
                  {c.name}
                </dt>
                <dd class="num mt-1 text-xl text-[var(--heading)] transition-colors group-hover:text-[var(--accent)]">
                  {String(c.posts.length).padStart(2, '0')}
                </dd>
              </a>
            </div>
          ))}
        </dl>

        {latest && (
          <p class="mt-5 text-[0.82rem] text-[var(--text-muted)]">
            마지막 글{' '}
            <a href={`/posts/${latest.id}/`} class="text-[var(--accent)]">
              {latest.data.title.split('] ').at(-1)}
            </a>
          </p>
        )}
      </section>

      {shelf && shelf.posts.length > 1 && <SeriesShelf group={shelf} />}
    </>
  )
}

<section>
  <div class="mb-3 flex items-baseline justify-between gap-4">
    <h2 class="text-[0.9rem] font-semibold text-[var(--text-muted)]">
      {page === 1 ? '최근 글' : '글 목록'}
    </h2>
    <a href="/archives/" class="shrink-0 text-sm text-[var(--text-muted)] hover:text-[var(--accent)]">
      아카이브
    </a>
  </div>

  <PostList posts={posts} />
</section>

{
  totalPages > 1 && (
    <nav class="mt-8 flex items-center justify-between text-sm" aria-label="페이지">
      {page > 1 ? (
        <a href={pageHref(page - 1)} class="text-[var(--accent)]">
          이전
        </a>
      ) : (
        <span class="text-[var(--text-muted)] opacity-50">이전</span>
      )}

      <span class="num text-[var(--text-muted)]">
        {page} / {totalPages}
      </span>

      {page < totalPages ? (
        <a href={pageHref(page + 1)} class="text-[var(--accent)]">
          다음
        </a>
      ) : (
        <span class="text-[var(--text-muted)] opacity-50">다음</span>
      )}
    </nav>
  )
}
