---
import { stripSeriesPrefix, type Group } from '../lib/posts';

interface Props {
  group: Group;
}

const { group } = Astro.props;

// Reading order, not newest first: a series is meant to be started at 1.
const posts = [...group.posts].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<section class="mb-10">
  <div class="mb-3 flex items-baseline justify-between gap-4">
    <h2 class="text-base font-semibold text-[var(--text-muted)]">
      최근 연재{' '}
      <a href={`/categories/${group.slug}/`} class="text-[var(--accent)]">{group.name}</a>
    </h2>
    <a
      href={`/categories/${group.slug}/`}
      class="shrink-0 text-sm text-[var(--text-muted)] hover:text-[var(--accent)]"
    >
      전체 보기
    </a>
  </div>

  <div class="shelf" data-shelf>
    <ol class="shelf-track" data-shelf-track>
      {
        posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`} class="shelf-card">
              {post.data.image ? (
                <img
                  src={post.data.image.path}
                  alt=""
                  loading="lazy"
                  class="aspect-video w-full rounded object-cover"
                />
              ) : (
                <span class="aspect-video w-full rounded bg-[var(--border)]" aria-hidden="true" />
              )}
              <span class="shelf-title">{stripSeriesPrefix(post.data.title)}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <!--
      Dragging a scrollbar is the worst way to move a row of cards with a
      mouse. These only appear where there is a pointer; touch already swipes.
    -->
    <button type="button" class="shelf-nav shelf-nav-prev" data-shelf-prev aria-label="이전 글">
      <span aria-hidden="true">‹</span>
    </button>
    <button type="button" class="shelf-nav shelf-nav-next" data-shelf-next aria-label="다음 글">
      <span aria-hidden="true">›</span>
    </button>
  </div>
</section>

<script>
  for (const shelf of document.querySelectorAll<HTMLElement>('[data-shelf]')) {
    const track = shelf.querySelector<HTMLElement>('[data-shelf-track]');
    const prev = shelf.querySelector<HTMLButtonElement>('[data-shelf-prev]');
    const next = shelf.querySelector<HTMLButtonElement>('[data-shelf-next]');
    if (!track || !prev || !next) continue;

    // One card plus its gap, so a click lands on a card edge and scroll-snap
    // has nothing to correct.
    const step = () => {
      const card = track.querySelector('li');
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      shelf.classList.toggle('is-scrollable', max > 1);
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

    track.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(sync).observe(track);
    sync();
  }
</script>
