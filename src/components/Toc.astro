---
import type { MarkdownHeading } from 'astro';
import { tocHeadings } from '../lib/headings';

interface Props {
  headings: MarkdownHeading[];
  /** Raw markdown, used to recover heading text that KaTeX mangled. */
  body?: string;
  /**
   * `rail` - the static column in the right gutter on wide screens.
   * `edge` - dashes pinned to the window edge that open on hover or tap, for
   *          viewports with no gutter to spare.
   */
  variant: 'rail' | 'edge';
  class?: string;
}

const { headings, body, variant, class: className } = Astro.props;

const items = tocHeadings(headings, body);

// Posts are inconsistent about depth: the RL series goes h2 -> h4 while the
// algorithm posts go h2 -> h3, for the same "1-1" level of sub-section.
// Indenting by raw depth would push one of them in twice as far as the other,
// so rank the depths that actually occur and indent by that instead.
const present = [...new Set(items.map((h) => h.depth))].sort((a, b) => a - b);
const levelOf = (depth: number) => present.indexOf(depth);
---

{
  items.length > 1 && (
    <nav aria-label="목차" class:list={[variant === 'edge' ? 'toc-edge' : 'toc-rail', className]}>
      <ul>
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="toc-link"
              data-toc-link={h.slug}
              data-level={levelOf(h.depth)}
            >
              <span class="toc-dash" aria-hidden="true" />
              <span class="toc-text">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // One observer drives every copy of the list, so the rail and the edge
  // dashes cannot disagree about where the reader is.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const bySlug = new Map<string, HTMLAnchorElement[]>();
    for (const a of links) {
      const slug = a.dataset.tocLink!;
      const list = bySlug.get(slug);
      if (list) list.push(a);
      else bySlug.set(slug, [a]);
    }

    const headings = [...bySlug.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let active: string | null = null;
    const update = () => {
      const passed = headings.filter((h) => h.getBoundingClientRect().top < 120);
      const slug = passed.at(-1)?.id ?? headings[0]?.id;
      if (!slug || slug === active) return;
      if (active) for (const a of bySlug.get(active) ?? []) a.classList.remove('is-active');
      for (const a of bySlug.get(slug) ?? []) a.classList.add('is-active');
      active = slug;
    };

    const observer = new IntersectionObserver(update, {
      rootMargin: '-100px 0px -75% 0px',
      threshold: 0,
    });
    for (const h of headings) observer.observe(h);
    update();
  }

  // Touch has no hover, so the dashes would never open. There the first tap
  // opens the panel instead of following a link; taps after that behave
  // normally, and a tap outside closes it.
  const edge = document.querySelector<HTMLElement>('.toc-edge');
  if (edge && !matchMedia('(hover: hover) and (pointer: fine)').matches) {
    edge.addEventListener('click', (event) => {
      if (!edge.classList.contains('is-open')) {
        event.preventDefault();
        edge.classList.add('is-open');
      }
    });

    document.addEventListener('click', (event) => {
      if (!edge.contains(event.target as Node)) edge.classList.remove('is-open');
    });
  }
</script>
