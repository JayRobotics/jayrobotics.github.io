---
import type { MarkdownHeading } from 'astro';
import { tocHeadings } from '../lib/headings';

interface Props {
  headings: MarkdownHeading[];
  /** Raw markdown, used to recover heading text that KaTeX mangled. */
  body?: string;
  /**
   * `rail` - the static column in the right gutter on wide screens.
   * `edge` - marks pinned to the window edge that open on hover or tap, for
   *          viewports with no gutter to spare.
   */
  variant: 'rail' | 'edge';
  class?: string;
}

const { headings, body, variant, class: className } = Astro.props;

const items = tocHeadings(headings, body);

// Posts are inconsistent about depth: the RL series goes h2 -> h4 while the
// algorithm posts go h2 -> h3, for the same "1-1" level of sub-section.
// Indenting by raw depth would push one of them in twice as far as the other,
// so rank the depths that actually occur and indent by that instead.
const present = [...new Set(items.map((h) => h.depth))].sort((a, b) => a - b);
const levelOf = (depth: number) => present.indexOf(depth);
---

{
  items.length > 1 &&
    (variant === 'rail' ? (
      <nav aria-label="목차" class:list={['toc-rail', className]}>
        <ul>
          {items.map((h) => (
            <li>
              <a
                href={`#${h.slug}`}
                class="toc-link"
                data-toc-link={h.slug}
                data-level={levelOf(h.depth)}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      /*
        Two layers rather than one list that transforms. A single list has to
        choose between staying compact when closed and never reflowing: either
        the text takes up height while hidden, leaving the marks sparse, or it
        does not and every row unfolds on open. Keeping them separate means
        nothing ever moves; only opacity crosses between the two.
      */
      <nav aria-label="목차" class:list={['toc-edge', className]}>
        <div class="toc-edge-marks" aria-hidden="true">
          {items.map((h) => (
            <span class="toc-mark" data-toc-mark={h.slug} data-level={levelOf(h.depth)} />
          ))}
        </div>

        <div class="toc-edge-panel">
          <ul>
            {items.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="toc-link"
                  data-toc-link={h.slug}
                  data-level={levelOf(h.depth)}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    ))
}

<script>
  // One observer drives every copy, so the rail, the marks and the panel
  // cannot disagree about where the reader is.
  const targets = document.querySelectorAll<HTMLElement>('[data-toc-link], [data-toc-mark]');
  if (targets.length > 0) {
    const bySlug = new Map<string, HTMLElement[]>();
    for (const el of targets) {
      const slug = el.dataset.tocLink ?? el.dataset.tocMark!;
      const list = bySlug.get(slug);
      if (list) list.push(el);
      else bySlug.set(slug, [el]);
    }

    const headings = [...bySlug.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let active: string | null = null;
    const update = () => {
      const passed = headings.filter((h) => h.getBoundingClientRect().top < 120);
      const slug = passed.at(-1)?.id ?? headings[0]?.id;
      if (!slug || slug === active) return;
      if (active) for (const el of bySlug.get(active) ?? []) el.classList.remove('is-active');
      for (const el of bySlug.get(slug) ?? []) el.classList.add('is-active');
      active = slug;
    };

    const observer = new IntersectionObserver(update, {
      rootMargin: '-100px 0px -75% 0px',
      threshold: 0,
    });
    for (const h of headings) observer.observe(h);
    update();
  }

  const edge = document.querySelector<HTMLElement>('.toc-edge');
  if (edge) {
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      // Clicking a link leaves focus on it, and :focus-within would then hold
      // the panel open after the pointer has gone.
      edge.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest('a');
        if (link) (link as HTMLElement).blur();
      });
    } else {
      // Touch has no hover, so the marks would never open. There the first tap
      // opens the panel; a tap on a link, or outside it, closes it again.
      edge.addEventListener('click', (event) => {
        if (!edge.classList.contains('is-open')) {
          event.preventDefault();
          edge.classList.add('is-open');
          return;
        }
        if ((event.target as HTMLElement).closest('a')) edge.classList.remove('is-open');
      });

      document.addEventListener('click', (event) => {
        if (!edge.contains(event.target as Node)) edge.classList.remove('is-open');
      });
    }
  }
</script>
