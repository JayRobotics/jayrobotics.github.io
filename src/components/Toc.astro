---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /**
   * `rail`  - the static column in the right gutter on wide screens.
   * `edge`  - dashes pinned to the window edge that open on hover, for
   *           viewports with no gutter to spare (portrait monitors, laptops).
   * `plain` - a normal list, used inside the <details> fallback on touch.
   */
  variant?: 'rail' | 'edge' | 'plain';
  class?: string;
}

const { headings, variant = 'plain', class: className } = Astro.props;

// h2 and h3 only. Deeper levels make the list taller than the screen.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);

const wrapperClass = variant === 'edge' ? 'toc-edge' : variant === 'rail' ? 'toc-rail' : 'toc-plain';
---

{
  items.length > 1 && (
    <nav aria-label="목차" class:list={[wrapperClass, className]}>
      <ul>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug} data-depth={h.depth}>
              <span class="toc-dash" aria-hidden="true" />
              <span class="toc-text">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // One observer drives every copy of the list on the page, so the rail and
  // the edge dashes never disagree about where the reader is.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const bySlug = new Map<string, HTMLAnchorElement[]>();
    for (const a of links) {
      const slug = a.dataset.tocLink!;
      const list = bySlug.get(slug);
      if (list) list.push(a);
      else bySlug.set(slug, [a]);
    }

    const headings = [...bySlug.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let active: string | null = null;
    const setActive = (slug: string) => {
      if (slug === active) return;
      if (active) for (const a of bySlug.get(active) ?? []) a.classList.remove('is-active');
      for (const a of bySlug.get(slug) ?? []) a.classList.add('is-active');
      active = slug;
    };

    // IntersectionObserver rather than a scroll listener: nothing runs on
    // frames where no heading crossed the line.
    const update = () => {
      const passed = headings.filter((h) => h.getBoundingClientRect().top < 120);
      const slug = passed.at(-1)?.id ?? headings[0]?.id;
      if (slug) setActive(slug);
    };

    const observer = new IntersectionObserver(update, {
      rootMargin: '-100px 0px -75% 0px',
      threshold: 0,
    });
    for (const h of headings) observer.observe(h);
    update();
  }
</script>
