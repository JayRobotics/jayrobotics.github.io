---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** The rail copy is the one that tracks scrolling. */
  tracking?: boolean;
  class?: string;
}

const { headings, tracking = false, class: className } = Astro.props;

// h2 and h3 only. Deeper levels make the list taller than the screen.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 1 && (
    <nav aria-label="목차" class={className} data-toc={tracking ? 'tracking' : undefined}>
      <ul class="space-y-1 text-sm">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                'block border-s-2 py-0.5 transition-colors',
                h.depth === 3 ? 'ps-5' : 'ps-3',
                'border-transparent text-[var(--text-muted)] hover:text-[var(--accent)]',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Highlights the section being read. IntersectionObserver rather than a
  // scroll listener: no work on frames where nothing crossed.
  const rail = document.querySelector('[data-toc="tracking"]');
  if (rail) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const a of rail.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) {
      links.set(a.dataset.tocLink!, a);
    }

    const headings = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const ACTIVE = ['!border-[var(--accent)]', '!text-[var(--accent)]'];
    let current: HTMLAnchorElement | null = null;

    const setActive = (slug: string) => {
      const next = links.get(slug);
      if (!next || next === current) return;
      current?.classList.remove(...ACTIVE);
      next.classList.add(...ACTIVE);
      current = next;
    };

    // Only the top fifth of the viewport counts as "being read", so the
    // highlight advances as a heading reaches the top rather than the middle.
    const seen = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) seen.add(entry.target.id);
          else seen.delete(entry.target.id);
        }
        // Headings above the line are the ones already passed; take the last.
        const passed = headings.filter((h) => h.getBoundingClientRect().top < 120);
        const active = passed.at(-1)?.id ?? headings[0]?.id;
        if (active) setActive(active);
      },
      { rootMargin: '-100px 0px -80% 0px', threshold: 0 },
    );

    for (const h of headings) observer.observe(h);
  }
</script>
